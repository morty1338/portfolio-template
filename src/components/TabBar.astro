---
/* Phone navigation: fixed bottom tab bar, so "Contact" is always one tap away (docs/PLAYBOOK.md §7). */
import type { Locale } from '../config/site';
import { isCurrentSection, navigation } from '../config/navigation';
import { localizePath, splitLocale } from '../i18n/routing';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const current = splitLocale(Astro.url.pathname).path;
---

<nav class="tabbar" aria-label={t('nav.label')}>
  <ul>
    {navigation.map((item) => (
      <li>
        <a
          href={localizePath(item.path, locale)}
          class:list={{ cta: item.cta }}
          aria-current={isCurrentSection(current, item.path) ? 'page' : undefined}
          data-track={item.cta ? 'contact-click' : undefined}
          data-track-from={item.cta ? 'tabbar' : undefined}
        >
          {t(item.key)}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  /* No transform/backdrop-filter on ancestors: they would break position: fixed. */
  .tabbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 10;
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--surface-1);
    border-top: 1px solid var(--line);
  }
  ul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: var(--tabbar-h);
    padding: 0;
    list-style: none;
  }
  a {
    display: grid;
    place-items: center;
    height: 100%;
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--ink-2);
  }
  a[aria-current='page'] {
    color: var(--ink-1);
    font-weight: 600;
    box-shadow: inset 0 3px 0 var(--ink-1);
  }
  a.cta {
    color: var(--accent);
    font-weight: 600;
  }
  @media (min-width: 600px) {
    .tabbar {
      display: none;
    }
  }
</style>
