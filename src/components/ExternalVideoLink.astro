---
/** For videos that can't be embedded yet (Google Drive files and folders, other links): a poster with a clear link. */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../config/site';
import { useTranslations } from '../i18n/ui';
import type { VideoInfo } from '../lib/video';

interface Props {
  video: VideoInfo;
  title: string;
  thumbnail?: ImageMetadata;
  locale: Locale;
}
const { video, title, thumbnail, locale } = Astro.props;
const t = useTranslations(locale);
const label =
  video.provider === 'gdrive'
    ? t('project.driveLink')
    : video.provider === 'gdrive-folder'
      ? t('project.driveFolder')
      : t('project.externalLink');
---

<div class="external">
  {thumbnail && (
    <Picture
      src={thumbnail}
      alt=""
      widths={[640, 960, 1280]}
      sizes="(min-width: 960px) 60rem, 100vw"
      formats={['avif', 'webp']}
      loading="eager"
    />
  )}
  <div class="overlay">
    {!thumbnail && (
      <span class="title" aria-hidden="true">
        {title}
      </span>
    )}
    <a class="button button--primary" href={video.url} target="_blank" rel="noopener">
      {label}
      <span aria-hidden="true">↗</span>
      <span class="visually-hidden">{t('project.opensNewTab')}</span>
    </a>
  </div>
</div>

<style>
  /* Image (if any) and overlay share one grid cell; the overlay stacks title and button. */
  .external {
    display: grid;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--ink-1);
  }
  .external > :global(*) {
    grid-area: 1 / 1;
  }
  .external :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .overlay {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-4);
    text-align: center;
  }
  .title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.15;
    color: var(--bg);
  }
</style>
