---
/**
 * Click-to-load video. Until the visitor clicks, the page only shows our own (self-hosted)
 * thumbnail: no request goes to YouTube/Vimeo, so no cookies and no IP transfer before consent.
 * Without JavaScript the play button is a normal link to the video on YouTube/Vimeo.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../config/site';
import { useTranslations } from '../i18n/ui';
import type { VideoInfo } from '../lib/video';

interface Props {
  video: VideoInfo & { embedUrl: string };
  title: string;
  projectId: string;
  thumbnail?: ImageMetadata;
  locale: Locale;
}
const { video, title, projectId, thumbnail, locale } = Astro.props;
const t = useTranslations(locale);
const provider = video.provider === 'vimeo' ? 'Vimeo' : 'YouTube';
const noticeId = `video-notice-${projectId}`;
---

<div class="video" data-video-facade data-embed={video.embedUrl} data-title={title} data-project={projectId}>
  <a
    class="play"
    href={video.url}
    target="_blank"
    rel="noopener"
    aria-label={t('project.playTitle', { title, provider })}
    aria-describedby={noticeId}
  >
    {thumbnail ? (
      <Picture
        src={thumbnail}
        alt=""
        widths={[640, 960, 1280]}
        sizes="(min-width: 960px) 60rem, 100vw"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <span class="placeholder" aria-hidden="true">
        {title}
      </span>
    )}
    <span class="icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="28" height="28">
        <path d="M8 5v14l11-7z" fill="currentColor"></path>
      </svg>
    </span>
  </a>
  <p class="notice muted" id={noticeId}>
    {t('project.playNotice', { provider })}
  </p>
</div>

<script>
  // Replace the link with the provider's iframe on click (one facade per video, any number per page).
  for (const facade of document.querySelectorAll<HTMLElement>('[data-video-facade]')) {
    const link = facade.querySelector<HTMLAnchorElement>('a.play');
    link?.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey) return; // let "open in new tab" work
      event.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = facade.dataset.embed!;
      iframe.title = facade.dataset.title!;
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      link.replaceWith(iframe);
      iframe.focus();
      document.dispatchEvent(
        new CustomEvent('portfolio:track', { detail: { name: 'video-play', project: facade.dataset.project } }),
      );
    });
  }
</script>

<style>
  .video {
    display: grid;
    gap: var(--space-2);
  }
  .play,
  .video :global(iframe) {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--ink-1);
  }
  .play :global(img),
  .placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--bg);
  }
  .icon {
    position: absolute;
    inset: 50% auto auto 50%;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    margin: -2.25rem 0 0 -2.25rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    transition: transform 0.15s ease;
  }
  .play:hover .icon,
  .play:focus-visible .icon {
    transform: scale(1.08);
  }
  .play:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .notice {
    font-size: var(--step--1);
  }
</style>
